# MongoDB connection
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/your_database_name?retryWrites=true&w=majority

# JWT secret for signing tokens
JWT_SECRET=your_jwt_secret_here

# SMTP Configuration (Gmail)
EMAIL_USER=your_email@gmail.com       # Your Gmail address (used to send emails)
EMAIL_PASS=your_app_password_here     # Gmail App Password (NOT your normal Gmail password)

# Public Base URL 
NEXT_PUBLIC_BASE_URL=http://localhost:3000    # Used for links in verification emails 